<Window x:Class="LiveApp.UI.CSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LiveApp.UI.CSharp"
        mc:Ignorable="d"
        Title="live-app" Height="720" Width="1280">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border BorderBrush="Gray" BorderThickness="1" Margin="5">
                <ItemsControl x:Name="PreviewItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{Binding Bitmap}" Width="{Binding Width}" Height="{Binding Height}"
                                   Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}"
                                   MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown" MouseMove="PreviewImage_MouseMove" MouseLeftButtonUp="PreviewImage_MouseLeftButtonUp"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <ComboBox x:Name="TransitionComboBox" Margin="5" SelectionChanged="TransitionComboBox_SelectionChanged">
                    <ComboBoxItem Content="Cut"/>
                    <ComboBoxItem Content="Fade"/>
                </ComboBox>
                <Button Content="Transition" Margin="5" Click="Transition_Click"/>
                <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Height="100">
                    <Image x:Name="TransitionPreviewImage"/>
                </Border>
            </StackPanel>

            <Border BorderBrush="Red" BorderThickness="2" Grid.Column="2" Margin="5">
                <Image x:Name="ProgramImage" />
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Add Webcam" Click="AddWebcam_Click" Margin="5"/>
            <Button Content="Add Screen Capture" Click="AddScreenCapture_Click" Margin="5"/>
            <Button Content="Add Video File" Click="AddVideoFile_Click" Margin="5"/>
            <Button Content="Remove Source" Click="RemoveSource_Click" Margin="5"/>
            <Button Content="Start Recording" Click="StartRecording_Click" Margin="5"/>
            <Button Content="Stop Recording" Click="StopRecording_Click" Margin="5"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Scenes" Margin="5">
                <Grid>
                    <ListBox x:Name="ScenesListBox" SelectionChanged="ScenesListBox_SelectionChanged"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="Add" Click="AddScene_Click"/>
                        <Button Content="Remove" Click="RemoveScene_Click"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Header="Sources" Grid.Column="1" Margin="5">
                <ListBox x:Name="SourcesListBox" SelectionChanged="SourcesListBox_SelectionChanged"/>
            </GroupBox>

            <GroupBox Header="Audio Mixer" Grid.Column="2" Margin="5">
                <ListBox x:Name="AudioMixerListBox">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"/>
                                <Slider Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}" ValueChanged="Volume_ValueChanged"/>
                                <CheckBox Content="Mute" IsChecked="{Binding IsMuted, Mode=TwoWay}" Checked="Mute_Checked" Unchecked="Mute_Unchecked"/>
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding VuValue}" Height="10"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
