<Window x:Class="LiveApp.UI.CSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LiveApp.UI.CSharp"
        mc:Ignorable="d"
        Title="live-app" Height="720" Width="1280">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Image x:Name="WebcamImage" Grid.Row="0"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Start Webcam" Click="StartWebcam_Click" Margin="5"/>
            <Button Content="Stop Webcam" Click="StopWebcam_Click" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
